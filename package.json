{
  "name": "vault-tool",
  "displayName": "Vault Tool",
  "description": "Herramienta local para gestionar el vault de notas (sustituto de Obsidian)",
  "version": "0.0.1",
  "publisher": "angel-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vaultTool.listNotes",
        "title": "Vault Tool: Listar notas del vault"
      },
      {
        "command": "vaultTool.openKanban",
        "title": "Vault Tool: Abrir Kanban del vault"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
