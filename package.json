{
  "name": "obsidian-like",
  "displayName": "Obsidian-like",
  "description": "Herramienta local para gestionar el vault de notas (sustituto de Obsidian)",
  "version": "0.0.1",
  "publisher": "angelCastro",
  "icon": "media/obsidian-icon-violeta.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "themes": [
      {
        "label": "Border Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/border-dark.json"
      },
      {
        "label": "Border Light",
        "uiTheme": "vs",
        "path": "./themes/border-light.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "vaultTool.markdownEditor",
        "displayName": "Obsidian-like: Vista de documento",
        "selector": [{ "filenamePattern": "*.md" }],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Obsidian-like",
      "properties": {
        "obsidianLike.markdownFont": {
          "type": "string",
          "default": "",
          "markdownDescription": "Fuente para archivos Markdown. Acepta el mismo formato que `editor.fontFamily` (ej: `'iA Writer Quattro S', Georgia, serif`). Vacío usa la fuente general del editor."
        },
        "obsidianLike.codeFont": {
          "type": "string",
          "default": "",
          "markdownDescription": "Fuente monoespaciada para código inline (`` `texto` ``) y bloques de código. Acepta el mismo formato que `editor.fontFamily`. Vacío usa la fuente monoespaciada del tema de Obsidian o, en su defecto, la del editor."
        },
        "obsidianLike.codeFontSize": {
          "type": "number",
          "default": 14,
          "description": "Tamaño en píxeles para código inline y bloques de código."
        },
        "obsidianLike.attachmentsLocation": {
          "type": "string",
          "enum": ["vault", "samefolder", "subfolder", "specificfolder"],
          "enumDescriptions": [
            "Carpeta raíz de la bóveda (carpeta de workspace)",
            "Misma carpeta que el archivo .md",
            "Subcarpeta dentro de la carpeta del archivo (el nombre se configura en attachmentsFolder)",
            "Carpeta específica (la ruta se configura en attachmentsFolder)"
          ],
          "default": "vault",
          "description": "Dónde buscar los archivos adjuntos referenciados con ![[nombre]]"
        },
        "obsidianLike.attachmentsFolder": {
          "type": "string",
          "default": "attachments",
          "description": "Nombre de la subcarpeta (modo 'subfolder') o ruta completa/relativa a la bóveda (modo 'specificfolder')"
        },
        "obsidianLike.obsidianTheme": {
          "type": "string",
          "default": "",
          "description": "Nombre del tema de Obsidian a aplicar. Carga .obsidian/themes/{nombre}/theme.css desde la carpeta raíz del vault."
        }
      }
    },
    "commands": [
      {
        "command": "vaultTool.listNotes",
        "title": "Obsidian-like: Listar notas del vault"
      },
      {
        "command": "vaultTool.openKanban",
        "title": "Obsidian-like: Abrir Kanban del vault"
      },
      {
        "command": "vaultTool.toggleSourceMode",
        "title": "Obsidian-like: Alternar vista fuente / WYSIWYG"
      },
      {
        "command": "vaultTool.insertAttachment",
        "title": "Obsidian-like: Insertar como adjunto en la nota activa"
      },
      {
        "command": "vaultTool.openNoteQuickPick",
        "title": "Obsidian-like: Abrir nota…"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vaultTool.insertAttachment",
          "group": "6_copypath"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vaultTool.openNoteQuickPick",
        "key": "ctrl+o",
        "mac": "cmd+o",
        "when": "activeCustomEditorId == 'vaultTool.markdownEditor'"
      },
      {
        "command": "vaultTool._openNoteQuickPickInNewTab",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "vaultToolQuickPickActive"
      },
      {
        "command": "vaultTool._openNoteQuickPickToSide",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "vaultToolQuickPickActive"
      }
    ],
    "configurationDefaults": {
      "breadcrumbs.enabled": false
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build-webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build-webview": "esbuild webview-src/editor.js --bundle --minify --outfile=out/editor.bundle.js --platform=browser --format=iife",
    "package": "npm run compile && npm run build-webview && vsce package --allow-missing-repository"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "marked": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
