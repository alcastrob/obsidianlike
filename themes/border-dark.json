  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#74778b", "fontStyle": "italic" }
    },
    {
      "name": "Keyword / Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.other.important",
        "storage.modifier",
        "storage.type"
      ],
      "settings": { "foreground": "#f2b6de" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#7cd37c" }
    },
    {
      "name": "String escape / Regex",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#86dfe2" }
    },
    {
      "name": "Number / Constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": { "foreground": "#cb9eff" }
    },
    {
      "name": "Function / Method",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.method-call entity.name.function"
      ],
      "settings": { "foreground": "#ffe88b" }
    },
    {
      "name": "Class / Type / Interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.namespace",
        "entity.name.enum",
        "entity.name.struct",
        "support.class",
        "support.type"
      ],
      "settings": { "foreground": "#89bdf4" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other", "variable.language", "variable.parameter"],
      "settings": { "foreground": "#d3d5de" }
    },
    {
      "name": "Property / Attribute",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": { "foreground": "#86dfe2" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#ff7881" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.definition", "punctuation.section", "meta.brace"],
      "settings": { "foreground": "#b8bac7" }
    },
    {
      "name": "HTML / JSX Tag",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#ff7881" }
    },
    {
      "name": "HTML attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#86dfe2" }
    },
    {
      "name": "CSS property",
      "scope": ["support.type.property-name.css", "source.css support.type"],
      "settings": { "foreground": "#86dfe2" }
    },
    {
      "name": "CSS value",
      "scope": ["support.constant.property-value.css", "meta.property-value.css", "constant.other.color"],
      "settings": { "foreground": "#cb9eff" }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": { "foreground": "#ff7881" }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#707bc2", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#d3d5de", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#d3d5de", "fontStyle": "italic" }
    },
    {
      "name": "Markdown link / URL",
      "scope": ["string.other.link.title.markdown", "markup.underline.link"],
      "settings": { "foreground": "#707bc2" }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#b8bac7" }
    },
    {
      "name": "Markdown blockquote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#74778b", "fontStyle": "italic" }
    },
    {
      "name": "Markdown list bullet",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": { "foreground": "#707bc2" }
    },
    {
      "name": "Decorator / Annotation",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": { "foreground": "#fbbb83" }
    },
    {
      "name": "Type annotation",
      "scope": ["meta.type.annotation", "meta.type.parameters"],
      "settings": { "foreground": "#89bdf4" }
    },
    {
      "name": "Built-in support",
      "scope": ["support.variable", "support.other.variable"],
      "settings": { "foreground": "#86dfe2" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff7881", "fontStyle": "underline" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#74778b", "fontStyle": "strikethrough" }
    }
  ]
}
